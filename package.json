{
  "name": "@engager/headless",
  "version": "0.7.10",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "workspaces": ["packages/*"],
  "engines": { "node": ">=22" },
  "scripts": {
    "test": "vitest run",
    "engager": "node packages/cli/bin/engager.mjs",
    "up": "node packages/cli/bin/engager.mjs agent",
    "build": "npm run build -w engager",
    "db:generate": "tsx scripts/generate-migration.ts",
    "db:studio": "drizzle-kit studio --config=packages/database/drizzle.config.ts",
    "db:migrate": "tsx packages/database/migrate.ts",
    "pg:migrate": "npm run --silent db:migrate"
  },
  "devDependencies": {
    "@types/node": "^22.10.7",
    "@types/pg": "^8.20.0",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^4.1.11"
  }
}
